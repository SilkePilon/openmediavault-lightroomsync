#!/usr/bin/env dash
#
# This file is part of openmediavault-lightroomsync.
#
# @license   https://www.gnu.org/licenses/gpl.html GPL Version 3

set -e

case "$1" in
	remove)
		deb-systemd-invoke stop omv-lightroomsync.timer omv-lightroomsync.service || :
		deb-systemd-helper disable omv-lightroomsync.timer || :
		# The units are generated by the Salt deploy state, not shipped
		# by the package, so they have to be removed here.
		rm -f /etc/systemd/system/omv-lightroomsync.timer \
			/etc/systemd/system/omv-lightroomsync.service
		systemctl --system daemon-reload || :
	;;

	upgrade|deconfigure|failed-upgrade)
	;;

	*)
		echo "prerm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

#DEBHELPER#

exit 0
