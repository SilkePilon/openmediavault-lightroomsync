			"clientid": {
				"type": "string",
				"required": true
			},
			"clientsecret": {
				"type": "string",
				"required": true
			},
			"redirecturi": {
				"type": "string",
				"pattern": "^https://.+$",
				"required": true
			}
		}
	}
},{
	"type": "rpc",
	"id": "rpc.lightroomsync.completeauth",
	"params": {
		"type": "object",
		"properties": {
			"clientid": {
				"type": "string",
