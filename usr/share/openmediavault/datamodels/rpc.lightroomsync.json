				"required": true
			},
			"clientsecret": {
				"type": "string",
				"minLength": 1,
				"required": true
			},
			"redirecturi": {
				"type": "string",
				"pattern": "^https://.+$",
				"required": true
			},
			"authresponse": {
				"type": "string",
				"minLength": 1,
				"required": true
			}
		}
